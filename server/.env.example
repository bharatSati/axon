# ==============================================================================
# AXON SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=axon_jwt_secret_production_key_change_in_real_env_2026

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB & Atlas Native Vector Search)
# ------------------------------------------------------------------------------
# Reuses existing MongoDB database and collections (BrainKnowledge)
# If using MongoDB Atlas, vector search uses native $vectorSearch stage
MONGODB_URI=mongodb://localhost:27017/axon

# ------------------------------------------------------------------------------
# 2. LOCAL & OPEN-SOURCE RAG CONFIGURATION (FREE - NO API KEY REQUIRED)
# ------------------------------------------------------------------------------
# Embedding model: Sentence Transformers (all-MiniLM-L6-v2) 384 dimensions
# Runs 100% locally via Transformers.js / ONNX Runtime. Completely FREE.
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.15
ATLAS_VECTOR_INDEX_NAME=vector_index

# ------------------------------------------------------------------------------
# 3. LLM GENERATION & SYNTHESIS (Optional Groq API or Local Fallback)
# ------------------------------------------------------------------------------
# Free Tier available at: https://console.groq.com/keys
# Model: openai/gpt-oss-120b for ultra-fast, context-grounded architectural answers.
# If no key is provided, Project Brain automatically uses local structured synthesis.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# Optional Gemini API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. GITHUB OAUTH & INTEGRATION
# ------------------------------------------------------------------------------
# Create a GitHub App or OAuth App at: https://github.com/settings/developers
# - Homepage URL: http://localhost:5173
# - Authorization callback URL: http://localhost:4000/api/auth/github/callback
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
GITHUB_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. RAZORPAY PAYMENT GATEWAY (Test Mode & Live Integration)
# ------------------------------------------------------------------------------
# Get your Test Keys from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
# Example test key: rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
